# Test artifacts (generated during e2e tests, cleared on each run)
tests/fixtures/artifacts/
tests/fixtures/resources/

# Manual proof runs (local documents and real translations, not source)
proof/

# Logs
*.log

# macOS system files
.DS_Store

# Node.js modules
node_modules/

# Test coverage
coverage/

# IDE
.vscode/settings.json

# Obsidian vault workspace (sensitive documents - NOT committed)
workspace/input/*
workspace/markdown/*
workspace/output/*
workspace/review/*
workspace/.obsidian/workspace.json
workspace/.obsidian/app.json
workspace/temp/
workspace/.batch-status.json

# Secrets
.env

# SEO files rendered from apps/landing/seo/ by scripts/render-seo.mjs
apps/landing/public/sitemap.xml
apps/landing/public/robots.txt
apps/landing/public/llms.txt
apps/landing/public/manifest.webmanifest

# Build outputs
dist/
apps/desktop/dist/
apps/desktop/dist-electron/

# Agent harness scratch (machine-local)
.factory/
