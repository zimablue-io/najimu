{
	"name": "najimu",
	"version": "0.3.1",
	"private": true,
	"author": "zimablue-io",
	"type": "module",
	"description": "Documents that fit in",
	"license": "SEE LICENSE IN LICENSE.md",
	"scripts": {
		"dev:desktop": "pnpm --filter @najimu/desktop dev",
		"dev:landing": "pnpm --filter @najimu/landing dev",
		"build:core": "pnpm --filter @najimu/core build",
		"build:desktop": "pnpm --filter @najimu/desktop build",
		"build:landing": "pnpm --filter @najimu/landing build",
		"build": "pnpm run build:core && pnpm run build:desktop",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test": "vitest run",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/node": "^22.15.3",
		"husky": "^9.1.7",
		"knip": "^6.7.0",
		"typescript": "^5.8.3",
		"vitest": "^5.0.3"
	}
}
