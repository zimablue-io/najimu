{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*",
    "src/lib/commercial.ts",
    "src/lib/license.ts",
    "src/lib/audit.ts",
    "src/lib/glossary.ts",
    "src/lib/memory.ts"
  ]
}
