# Environment variables read by the landing site. One entry per variable.
#
# Onboarding:   cp apps/landing/.env.example apps/landing/.env
# Then edit .env to point a local build elsewhere, e.g. a preview domain.
#
# Precedence, lowest to highest:
#   .env.example  ->  .env  ->  .env.local  ->  real env vars (CI, Vercel)
#
# Values below are the production defaults. A fresh clone builds correctly without
# a .env; CI and Vercel override them with real environment variables.

# Origin the landing site is served from.
# Substituted into index.html (canonical, og:*, twitter:*, JSON-LD) and into
# apps/landing/seo/* via scripts/render-seo.mjs. Read in app code via SITE_URL.
VITE_SITE_URL=https://najimu.zimablue.io

# Repository root, no trailing slash.
# Substituted into index.html (download links) and into apps/landing/seo/*.
# Read in app code via REPO_URL, releasesUrl, licenseUrl.
VITE_REPO_URL=https://github.com/zimablue-io/najimu
